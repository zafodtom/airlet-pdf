# Immutable upstream release archives; no latest/master URLs.
set(AIRLET_PDFIUM_VERSION "8125")
if(NOT PDFIUM_ROOT)
  if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(_platform win-x64)
    set(_hash 9a964261760cff52570aabf038ab346d3a5034dd8b30d0d5fe8861235d356b8b)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(_platform linux-x64)
    set(_hash e1c3ce6e270cb5e0c20816b379ad9f2c1309972697c505f508de92bf5e7d6659)
  else()
    message(FATAL_ERROR "Supported: Windows/Linux x64; supply a verified PDFIUM_ROOT otherwise")
  endif()
  include(FetchContent)
  FetchContent_Declare(pdfium_archive
    URL "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/${AIRLET_PDFIUM_VERSION}/pdfium-${_platform}.tgz"
    URL_HASH "SHA256=${_hash}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(pdfium_archive)
  set(PDFIUM_ROOT "${pdfium_archive_SOURCE_DIR}")
endif()
add_library(pdfium SHARED IMPORTED GLOBAL)
set_target_properties(pdfium PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${PDFIUM_ROOT}/include")
if(WIN32)
  set_target_properties(pdfium PROPERTIES IMPORTED_IMPLIB "${PDFIUM_ROOT}/lib/pdfium.dll.lib" IMPORTED_LOCATION "${PDFIUM_ROOT}/bin/pdfium.dll")
else()
  set_target_properties(pdfium PROPERTIES IMPORTED_LOCATION "${PDFIUM_ROOT}/lib/libpdfium.so")
endif()
